<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ always shows a system launch splash. Matching the game's background colour
      (the launcher icon stays the default) hands off to the in-game splash without a flash (SPEC §12).
    -->
    <style name="GdxTheme" parent="android:Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/sortopia_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowSplashScreenBackground">@color/sortopia_background</item>
    </style>
</resources>
